#!/usr/bin/env python3
"""The picker.

One list of sessions, driven by the arrow keys, numbers, and the mouse. All
of its behaviour lives in ../lib/sessionkit_tui; this file only points Python
at that package and reports the exit code the launcher reads.
"""

from __future__ import annotations

import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(_HERE), "lib"))

from sessionkit_tui.app import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
