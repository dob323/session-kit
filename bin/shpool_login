  if (( ${#fields[@]} != 8 )); then
    echo "  The displayed row changed format. Nothing changed."
    return
  fi
  provider=$(decode64 "${fields[3]}")
  uuid=$(decode64 "${fields[6]}")
  confidence=$(decode64 "${fields[7]}")
  if [[ ( $provider != claude && $provider != codex ) ||
        $confidence != exact || -z $uuid ]]; then
