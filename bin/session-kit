#!/usr/bin/env bash
# Install and maintain a per-user Session Kit installation.

set -euo pipefail

program=${0##*/}
install_root=${SESSION_KIT_ROOT:-"$HOME/.local/lib/session-kit"}
bin_dir=${SESSION_KIT_BIN_DIR:-"$HOME/.local/bin"}
config_root=${SESSION_KIT_CONFIG_ROOT:-"${XDG_CONFIG_HOME:-"$HOME/.config"}/session-kit"}
state_root=${SESSION_KIT_STATE_DIR:-"${XDG_STATE_HOME:-"$HOME/.local/state"}/session-kit"}
systemd_root=${SESSION_KIT_SYSTEMD_ROOT:-"${XDG_CONFIG_HOME:-"$HOME/.config"}/systemd/user"}
bashrc_path=${SESSION_KIT_BASHRC:-"$HOME/.bashrc"}
integration_marker=${SESSION_KIT_INTEGRATION_MARKER:-"$state_root/integration-ready-v1"}
receipt_path=$state_root/install.json
login_start="# >>> session-kit managed integration >>>"
login_end="# <<< session-kit managed integration <<<"
helpers=(sp shpool_login shpool_status shpool_reaper codex_resume_here)
inventory_files=(
  lib/session_inventory.py
  lib/sessionkit_inventory/__init__.py
  lib/sessionkit_inventory/common.py
)

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  session-kit doctor [--json]
  session-kit update [--source PATH] [--enable-login|--disable-login]
  session-kit rollback [--to COMMIT]
  session-kit disable-login
  session-kit enable-login
  session-kit uninstall [--purge-code] [--purge-config]

From a cloned repository:
  ./install.sh --check
  ./install.sh [--enable-login|--disable-login] [--journal on|off]

Session Kit keeps transcripts, journals, and status data on this machine. It
does not send telemetry. Uninstalling never deletes journals or archives.
EOF
}

require_arg() {
  [[ -n ${2:-} ]] || die "$1 requires a value"
}

platform() {
  case "$(uname -s 2>/dev/null || true)" in
    Linux) printf 'linux\n' ;;
    Darwin) printf 'macos\n' ;;
    *) printf 'unsupported\n' ;;
  esac
}

stat_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

release_id_from_source() {
  local source=$1 release_id=${SESSION_KIT_RELEASE_ID:-}
  if [[ -n $release_id && ${SESSION_KIT_TESTING:-0} != 1 ]]; then
    die "SESSION_KIT_RELEASE_ID is reserved for isolated tests"
  fi
  if [[ -z $release_id ]] && command -v git >/dev/null 2>&1 &&
      git -C "$source" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    release_id=$(git -C "$source" rev-parse HEAD 2>/dev/null || true)
  fi
  [[ $release_id =~ ^[0-9a-f]{40}$ ]] ||
    die "install source must be a Git clone at a full 40-character commit"
  printf '%s\n' "$release_id"
}

check_source() {
  local source=$1 failed=0 current_platform command required
  current_platform=$(platform)
  case "$current_platform" in
    linux) printf 'OK    operating system: Linux\n' ;;
    macos)
      if [[ ${SESSION_KIT_MACOS_PREVIEW:-0} == 1 ]]; then
        printf 'WARN  operating system: experimental macOS core preview\n'
      else
        printf 'FAIL  macOS requires explicit SESSION_KIT_MACOS_PREVIEW=1 opt-in\n'
        failed=1
      fi
      ;;
    *)
      printf 'FAIL  operating system: only Linux and the macOS core preview are supported\n'
      failed=1
      ;;
  esac
  for command in bash python3 git; do
    if command -v "$command" >/dev/null 2>&1; then
      printf 'OK    command: %s\n' "$command"
    else
      printf 'FAIL  command missing: %s\n' "$command"
      failed=1
    fi
  done
  if (( BASH_VERSINFO[0] < 4 )); then
    printf 'FAIL  Bash 4 or newer is required\n'
    failed=1
  else
    printf 'OK    Bash: %s\n' "$BASH_VERSION"
  fi
  if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
    printf 'FAIL  Python 3.10 or newer is required\n'
    failed=1
  fi
  if command -v shpool >/dev/null 2>&1; then
    printf 'OK    shpool: %s\n' "$(command -v shpool)"
  else
    printf 'FAIL  shpool missing: install v0.11.0 with cargo install shpool --version 0.11.0 --locked\n'
    failed=1
  fi
  for required in \
    bin/sp bin/shpool_login bin/shpool_status bin/shpool_reaper \
    bin/codex_resume_here bin/session_kit_common bin/session-kit \
    "${inventory_files[@]}" bashrc/shpool.bashrc \
    deploy/session-kit-launcher config/projects.example.tsv \
    config/session-inventory.example.json config/shpool.example.toml; do
    if [[ ! -f $source/$required ]]; then
      printf 'FAIL  source file missing: %s\n' "$required"
      failed=1
    fi
  done
  if ! git -C "$source" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'FAIL  source is not a Git worktree\n'
    failed=1
  elif [[ ${SESSION_KIT_TESTING:-0} != 1 ]] &&
      [[ -n $(git -C "$source" status --porcelain --untracked-files=all) ]]; then
    printf 'FAIL  source worktree has uncommitted or untracked files\n'
    failed=1
  fi
  (( failed == 0 )) || return 1
  release_id_from_source "$source" >/dev/null
  printf 'OK    source: installable\n'
}

atomic_symlink() {
  local target=$1 destination=$2
  python3 - "$target" "$destination" <<'PY'
import os
import pathlib
import sys
import uuid

target, destination = sys.argv[1:3]
path = pathlib.Path(destination)
path.parent.mkdir(parents=True, exist_ok=True)
temporary = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
try:
    os.symlink(target, temporary)
    os.replace(temporary, path)
finally:
    try:
        temporary.unlink()
    except FileNotFoundError:
        pass
PY
}

write_receipt() {
  local release_id=$1 source=$2 previous=$3 current_platform=$4
  umask 077
  mkdir -p "$state_root"
  chmod 700 "$state_root" 2>/dev/null || true
  python3 - "$receipt_path" "$release_id" "$source" "$previous" "$current_platform" <<'PY'
import json
import os
import pathlib
import sys
import tempfile
import time

path, release_id, source, previous, platform = sys.argv[1:6]
destination = pathlib.Path(path)
payload = {
    "schema_version": 1,
    "installed_release": release_id,
    "previous_release": previous or None,
    "source": source,
    "platform": platform,
    "installed_at_unix": int(time.time()),
}
fd, temporary = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, destination)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
}

current_release_id() {
  local resolved
  [[ -L $install_root/current ]] || return 0
  resolved=$(cd -P -- "$install_root/current" 2>/dev/null && pwd) || return 0
  case "$resolved" in
    "$install_root"/releases/*) printf '%s\n' "${resolved##*/}" ;;
  esac
}

install_launchers() {
  local release_id=$1 helper
  mkdir -p "$bin_dir"
  for helper in "${helpers[@]}"; do
    install -m 0755 "$install_root/releases/$release_id/deploy/session-kit-launcher" \
      "$bin_dir/$helper"
  done
  install -m 0755 "$install_root/releases/$release_id/bin/session-kit" \
    "$bin_dir/session-kit"
}

install_defaults() {
  local release_id=$1
  mkdir -p "$config_root"
  chmod 700 "$config_root" 2>/dev/null || true
  [[ -e $config_root/projects.tsv ]] ||
    install -m 0600 "$install_root/releases/$release_id/config/projects.example.tsv" \
      "$config_root/projects.tsv"
  [[ -e $config_root/inventory.json ]] ||
    install -m 0600 "$install_root/releases/$release_id/config/session-inventory.example.json" \
      "$config_root/inventory.json"
  local shpool_config=${XDG_CONFIG_HOME:-"$HOME/.config"}/shpool/config.toml
  if [[ ! -e $shpool_config ]]; then
    mkdir -p "$(dirname -- "$shpool_config")"
    install -m 0600 "$install_root/releases/$release_id/config/shpool.example.toml" \
      "$shpool_config"
  fi
}

install_systemd_units() {
  local release_id=$1
  [[ $(platform) == linux ]] || return 0
  mkdir -p "$systemd_root"
  local unit shpool_path
  for unit in shpool.service shpool.socket shpool-reaper.service \
    shpool-reaper.timer session-kit-watchdog.service; do
    install -m 0644 "$install_root/releases/$release_id/systemd/$unit" \
      "$systemd_root/$unit"
  done
  shpool_path=$(command -v shpool)
  python3 - "$systemd_root/shpool.service" "$shpool_path" <<'PY'
import os
import pathlib
import sys
import tempfile

path = pathlib.Path(sys.argv[1])
executable = sys.argv[2]
if any(character.isspace() for character in executable):
    raise SystemExit("session-kit: shpool path contains whitespace; refusing systemd unit")
text = path.read_text(encoding="utf-8")
if text.count("@SHPOOL@") != 1:
    raise SystemExit("session-kit: shpool service template is invalid")
text = text.replace("@SHPOOL@", executable)
fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
try:
    os.fchmod(fd, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
}

rewrite_login() {
  local action=$1
  mkdir -p "$(dirname -- "$bashrc_path")"
  if [[ $action == disable && ! -e $bashrc_path && ! -L $bashrc_path ]]; then
    return 0
  fi
  [[ -e $bashrc_path ]] || : > "$bashrc_path"
  [[ -f $bashrc_path && ! -L $bashrc_path ]] ||
    die "refusing to modify non-regular shell file: $bashrc_path"
  python3 - "$bashrc_path" "$action" "$login_start" "$login_end" <<'PY'
import os
import pathlib
import sys
import tempfile

path_raw, action, start, end = sys.argv[1:5]
path = pathlib.Path(path_raw)
text = path.read_text(encoding="utf-8")
begin = text.find(start)
finish = text.find(end)
if (begin < 0) != (finish < 0) or (begin >= 0 and finish < begin):
    raise SystemExit("session-kit: shell integration markers are incomplete; refusing to edit")
if begin >= 0:
    finish += len(end)
    if finish < len(text) and text[finish] == "\n":
        finish += 1
    before = text[:begin].rstrip("\n")
    after = text[finish:].lstrip("\n")
    text = before + ("\n" if before and after else "") + after
if action == "enable":
    block = (
        f"{start}\n"
        'if [[ -r "$HOME/.local/lib/session-kit/current/bashrc/shpool.bashrc" ]]; then\n'
        '  source "$HOME/.local/lib/session-kit/current/bashrc/shpool.bashrc"\n'
        "fi\n"
        f"{end}\n"
    )
    text = text.rstrip("\n") + ("\n\n" if text.strip() else "") + block
fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
try:
    os.fchmod(fd, path.stat().st_mode & 0o777)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PY
}

backup_login_once() {
  local backup_root=$state_root/backups
  local backup=$backup_root/bashrc.before-session-kit
  local absent=$backup_root/bashrc.was-absent
  [[ -e $backup || -e $absent ]] && return 0
  umask 077
  mkdir -p "$backup_root"
  chmod 700 "$backup_root" 2>/dev/null || true
  if [[ -e $bashrc_path || -L $bashrc_path ]]; then
    [[ -f $bashrc_path && ! -L $bashrc_path ]] ||
      die "refusing to back up non-regular shell file: $bashrc_path"
    install -m 0600 "$bashrc_path" "$backup"
  else
    : > "$absent"
    chmod 600 "$absent"
  fi
}

set_journal_choice() {
  case "$1" in
    on)
      if [[ -e $HOME/.no_shpool_journal ]]; then
        [[ -f $HOME/.no_shpool_journal && ! -L $HOME/.no_shpool_journal ]] ||
          die "refusing to replace unsafe journal sentinel"
        command rm -- "$HOME/.no_shpool_journal"
      fi
      ;;
    off)
      if [[ -e $HOME/.no_shpool_journal ]]; then
        [[ -f $HOME/.no_shpool_journal && ! -L $HOME/.no_shpool_journal ]] ||
          die "refusing to replace unsafe journal sentinel"
      else
        (umask 077; : > "$HOME/.no_shpool_journal")
      fi
      ;;
    *) die "--journal must be on or off" ;;
  esac
}

enable_login() {
  backup_login_once
  rewrite_login enable
  if [[ -L $install_root/current ]]; then
    local release_id
    release_id=$(current_release_id)
    [[ $release_id =~ ^[0-9a-f]{40}$ ]] || die "active release is invalid"
    umask 077
    mkdir -p "$state_root"
    printf 'session-kit-integration-v1 %s\n' "$release_id" > "$integration_marker"
    chmod 600 "$integration_marker"
  fi
  printf 'SSH picker enabled in %s\n' "$bashrc_path"
}

disable_login() {
  rewrite_login disable
  if [[ -e $integration_marker ]]; then
    [[ -f $integration_marker && ! -L $integration_marker ]] ||
      die "refusing to remove unsafe integration marker"
    command rm -- "$integration_marker"
  fi
  printf 'SSH picker disabled. Existing sessions and journals were not changed.\n'
}

install_release() {
  local source=$1 release_id=$2
  local release_dir=$install_root/releases/$release_id
  if [[ -e $release_dir ]]; then
    [[ -d $release_dir && ! -L $release_dir ]] ||
      die "release path is unsafe: $release_dir"
    return 0
  fi
  mkdir -p "$install_root/releases"
  local staging=$install_root/releases/.install-"$release_id"-$$
  [[ ! -e $staging ]] || die "staging path already exists"
  mkdir "$staging"
  local item
  for item in bin lib bashrc config deploy systemd macos shpool-patch; do
    [[ -e $source/$item ]] || continue
    cp -R "$source/$item" "$staging/$item"
  done
  find "$staging" -type d -exec chmod 0755 {} +
  find "$staging" -type f -exec chmod a-w {} +
  find "$staging/bin" "$staging/deploy" -type f -exec chmod 0755 {} +
  mv "$staging" "$release_dir"
}

install_command() {
  local source= login=prompt journal=prompt answer
  while (($#)); do
    case "$1" in
      --source) require_arg "$1" "${2:-}"; source=$2; shift 2 ;;
      --enable-login) login=enable; shift ;;
      --disable-login) login=disable; shift ;;
      --journal) require_arg "$1" "${2:-}"; journal=$2; shift 2 ;;
      --non-interactive)
        [[ $login != prompt ]] || login=disable
        [[ $journal != prompt ]] || journal=on
        shift
        ;;
      *) die "unknown install option: $1" ;;
    esac
  done
  [[ -n $source ]] || die "install requires --source PATH"
  source=$(cd -- "$source" && pwd -P) || die "source is unavailable"
  check_source "$source"
  local release_id previous current_platform
  release_id=$(release_id_from_source "$source")
  previous=$(current_release_id)
  current_platform=$(platform)
  if [[ $login == prompt ]]; then
    if [[ -t 0 ]]; then
      printf 'Enable the Session Kit picker for interactive SSH logins? [Y/n] '
      read -r answer
      case ${answer:-y} in [Nn]*) login=disable ;; *) login=enable ;; esac
    else
      login=disable
    fi
  fi
  if [[ $journal == prompt ]]; then
    if [[ -t 0 ]]; then
      printf 'Keep local terminal journals for recovery? [Y/n] '
      read -r answer
      case ${answer:-y} in [Nn]*) journal=off ;; *) journal=on ;; esac
    else
      journal=on
    fi
  fi
  install_release "$source" "$release_id"
  atomic_symlink "$install_root/releases/$release_id" "$install_root/current"
  install_launchers "$release_id"
  install_defaults "$release_id"
  install_systemd_units "$release_id"
  set_journal_choice "$journal"
  if [[ $login == enable ]]; then enable_login; else disable_login; fi
  write_receipt "$release_id" "$source" "$previous" "$current_platform"
  printf 'Installed Session Kit release %s.\n' "$release_id"
  if [[ $current_platform == linux ]]; then
    printf 'User services were installed but not started. Review them, then run:\n'
    printf '  systemctl --user daemon-reload\n'
    printf '  systemctl --user enable --now shpool.socket shpool-reaper.timer\n'
  else
    printf 'macOS core preview installed. Watchdog repair and pruning remain disabled.\n'
  fi
  printf 'Run session-kit doctor before opening a new managed session.\n'
}

doctor_command() {
  local json=0
  [[ ${1:-} != --json ]] || { json=1; shift; }
  (($# == 0)) || die "unknown doctor option: $1"
  local current_platform release_id= failed=0 helper required row status name detail
  current_platform=$(platform)
  release_id=$(current_release_id)
  local -a checks=()
  add_check() {
    checks+=("$1"$'\t'"$2"$'\t'"$3")
    [[ $1 != fail ]] || failed=1
  }
  if [[ $current_platform != unsupported ]]; then
    add_check ok platform "$current_platform"
  else
    add_check fail platform "unsupported operating system"
  fi
  if [[ $release_id =~ ^[0-9a-f]{40}$ &&
        -d $install_root/releases/$release_id ]]; then
    local missing_release_file=
    for required in "${inventory_files[@]}"; do
      if [[ ! -f $install_root/releases/$release_id/$required ]]; then
        missing_release_file=$required
        break
      fi
    done
    if [[ -z $missing_release_file ]]; then
      add_check ok release "$release_id"
    else
      add_check fail release "active release missing $missing_release_file"
    fi
  else
    add_check fail release "no valid active release"
  fi
  if command -v shpool >/dev/null 2>&1; then
    add_check ok shpool "$(command -v shpool)"
  else
    add_check fail shpool "command unavailable"
  fi
  for helper in "${helpers[@]}"; do
    if [[ -x $bin_dir/$helper ]]; then
      add_check ok "$helper" "$bin_dir/$helper"
    else
      add_check fail "$helper" "launcher unavailable"
    fi
  done
  if [[ -f $integration_marker && ! -L $integration_marker &&
        $(stat_mode "$integration_marker") == 600 ]]; then
    add_check ok login "enabled with a private release marker"
  else
    add_check warn login "disabled or not yet validated"
  fi
  if (( json )); then
    printf '%s\n' "${checks[@]}" | python3 -c '
import json,sys
rows=[]
for line in sys.stdin:
    status,name,detail=line.rstrip("\n").split("\t",2)
    rows.append({"status":status,"name":name,"detail":detail})
print(json.dumps({"ok":all(r["status"]!="fail" for r in rows),"checks":rows},indent=2,sort_keys=True))
'
  else
    for row in "${checks[@]}"; do
      IFS=$'\t' read -r status name detail <<<"$row"
      printf '%-5s %-18s %s\n' "${status^^}" "$name" "$detail"
    done
  fi
  (( failed == 0 ))
}

update_command() {
  local source= login= journal=on
  while (($#)); do
    case "$1" in
      --source) require_arg "$1" "${2:-}"; source=$2; shift 2 ;;
      --enable-login) login=enable; shift ;;
      --disable-login) login=disable; shift ;;
      *) die "unknown update option: $1" ;;
    esac
  done
  if [[ -z $source && -r $receipt_path ]]; then
    source=$(python3 - "$receipt_path" <<'PY'
import json,sys
try:
    value=json.load(open(sys.argv[1],encoding="utf-8")).get("source","")
except (OSError,ValueError):
    value=""
print(value if isinstance(value,str) else "")
PY
)
  fi
  [[ -n $source ]] || die "update needs --source PATH"
  [[ ! -e $HOME/.no_shpool_journal ]] || journal=off
  local args=(--source "$source" --journal "$journal" --non-interactive)
  case "$login" in enable) args+=(--enable-login) ;; disable) args+=(--disable-login) ;; esac
  install_command "${args[@]}"
}

rollback_command() {
  local target=
  while (($#)); do
    case "$1" in
      --to) require_arg "$1" "${2:-}"; target=$2; shift 2 ;;
      *) die "unknown rollback option: $1" ;;
    esac
  done
  if [[ -z $target && -r $receipt_path ]]; then
    target=$(python3 - "$receipt_path" <<'PY'
import json,sys
try:
    value=json.load(open(sys.argv[1],encoding="utf-8")).get("previous_release","")
except (OSError,ValueError):
    value=""
print(value if isinstance(value,str) else "")
PY
)
  fi
  [[ $target =~ ^[0-9a-f]{40}$ ]] || die "rollback requires a full release commit"
  [[ -d $install_root/releases/$target && ! -L $install_root/releases/$target ]] ||
    die "rollback release is not installed: $target"
  local previous
  previous=$(current_release_id)
  atomic_symlink "$install_root/releases/$target" "$install_root/current"
  install_launchers "$target"
  if [[ -f $integration_marker && ! -L $integration_marker ]]; then
    printf 'session-kit-integration-v1 %s\n' "$target" > "$integration_marker"
    chmod 600 "$integration_marker"
  fi
  write_receipt "$target" "" "$previous" "$(platform)"
  printf 'Rolled back Session Kit to %s. Services were not restarted.\n' "$target"
}

uninstall_command() {
  local purge_code=0 purge_config=0 helper
  while (($#)); do
    case "$1" in
      --purge-code) purge_code=1; shift ;;
      --purge-config) purge_config=1; shift ;;
      *) die "unknown uninstall option: $1" ;;
    esac
  done
  disable_login
  for helper in "${helpers[@]}"; do
    [[ ! -e $bin_dir/$helper || ( -f $bin_dir/$helper && ! -L $bin_dir/$helper ) ]] ||
      die "refusing to remove unsafe launcher: $bin_dir/$helper"
    command rm -f -- "$bin_dir/$helper"
  done
  if (( purge_config )); then
    [[ ! -e $config_root || ( -d $config_root && ! -L $config_root ) ]] ||
      die "refusing to remove unsafe config directory"
    command rm -rf -- "$config_root"
  fi
  if (( purge_code )); then
    [[ ! -e $install_root || ( -d $install_root && ! -L $install_root ) ]] ||
      die "refusing to remove unsafe install directory"
    command rm -rf -- "$install_root"
  fi
  command rm -f -- "$receipt_path"
  printf 'Session Kit integration removed. Journals, archives, and session data were retained.\n'
  printf 'No service was stopped or restarted. Review active sessions before removing service files.\n'
}

command_name=${1:-help}
shift || true
case "$command_name" in
  check)
    source=
    while (($#)); do
      case "$1" in
        --source) require_arg "$1" "${2:-}"; source=$2; shift 2 ;;
        *) die "unknown check option: $1" ;;
      esac
    done
    [[ -n $source ]] || die "check requires --source PATH"
    check_source "$source"
    ;;
  install) install_command "$@" ;;
  doctor) doctor_command "$@" ;;
  update) update_command "$@" ;;
  rollback) rollback_command "$@" ;;
  enable-login) (($# == 0)) || die "enable-login takes no options"; enable_login ;;
  disable-login) (($# == 0)) || die "disable-login takes no options"; disable_login ;;
  uninstall) uninstall_command "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
