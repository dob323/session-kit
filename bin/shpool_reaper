#!/usr/bin/env bash
# Safe session-kit reaper.
#
# The normal report records verified seven-day empty-shell candidates for
# confirmed `sp prune`. `--auto-close` is narrower and may close only a
# generated, provider-exited terminal after 72 continuous hours of exact proof.

set -u

SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd -P)
RELEASE_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd -P)

if [[ ${SESSION_KIT_TESTING:-0} == 1 && -n ${SESSION_KIT_TEST_PLATFORM:-} ]]; then
  REAPER_PLATFORM=$SESSION_KIT_TEST_PLATFORM
else
  REAPER_PLATFORM=$(uname -s 2>/dev/null)
fi
STATE_DIR=${SESSION_KIT_STATE_DIR:-${XDG_STATE_HOME:-"$HOME/.local/state"}/session-kit}
PROC_ROOT=${SESSION_KIT_PROC_ROOT:-/proc}
SENTINEL=${SESSION_KIT_REAPER_SENTINEL:-"$HOME/.no_shpool_reaper"}
MAX_AGE_DAYS=${SESSION_KIT_PRUNE_DAYS:-7}
SHPOOL=${SESSION_KIT_SHPOOL_CMD:-}
DRY_RUN=${SESSION_KIT_REAPER_DRY_RUN:-0}
AUTO_CLOSE_HOURS=${SESSION_KIT_AUTO_CLOSE_HOURS:-72}
STATUS=${SESSION_KIT_STATUS_CMD:-"$SCRIPT_DIR/shpool_status"}
INVENTORY_CORE=${SESSION_KIT_INVENTORY_CORE:-"$RELEASE_DIR/lib/session_inventory.py"}
DARWIN_PROC_SNAPSHOT=
DARWIN_DAEMON_PID=

MODE=report
VERIFY_FILE=
case "${1:-}" in
  ""|--candidates) ;;
  --auto-close)
    [[ -z ${2:-} ]] || {
      echo "usage: shpool_reaper [--candidates|--auto-close|--verify-candidate <private-json>]" >&2
      exit 2
    }
    MODE=auto
    ;;
  --verify-candidate)
    [[ -n ${2:-} && -z ${3:-} ]] || {
      echo "usage: shpool_reaper [--candidates|--auto-close|--verify-candidate <private-json>]" >&2
      exit 2
    }
    MODE=verify
    VERIFY_FILE=$2
    ;;
  *)
    echo "usage: shpool_reaper [--candidates|--auto-close|--verify-candidate <private-json>]" >&2
    exit 2
    ;;
esac

if [[ -z $SHPOOL ]]; then SHPOOL=$(command -v shpool 2>/dev/null || true); fi
if [[ -z $SHPOOL ]]; then
  for candidate in "$HOME/.cargo/bin/shpool" /opt/homebrew/bin/shpool /usr/local/bin/shpool; do
    if [[ -x $candidate ]]; then SHPOOL=$candidate; break; fi
  done
fi

timestamp() { date -Is 2>/dev/null || date; }
fail() {
  printf '%s reaper report failed: %s\n' "$(timestamp)" "$*" >&2
  exit 1
}

expire_picker_temp_files() {
  [[ $MODE != verify && $DRY_RUN != 1 ]] || return 0
  [[ $REAPER_PLATFORM != Darwin ]] || return 0
  local expired
  expired=$(python3 - "$STATE_DIR" "$PROC_ROOT" <<'PY'
import os
import re
import stat
import sys
import time

state_raw, proc_raw = sys.argv[1:]
state = os.path.abspath(state_raw)
proc = os.path.abspath(proc_raw)
uid = os.geteuid()
pattern = re.compile(
    r"^(?:(?:login-(?:snapshot|view|projects|recovery)|picker-proof|sp-guard"
    r"|provider-proof|bounce-recheck|auto-close-proof)"
    r"\.[A-Za-z0-9_]{6,16}\.json"
    r"|\.inventory\.json\.[A-Za-z0-9_]{6,16})$"
)

try:
    proc_names = os.listdir(proc)
except OSError:
    raise SystemExit(0)

# A picker may still refer to one of its private temp files while waiting for
# input. Leak rather than delete whenever any same-user picker is live or its
# process identity cannot be read safely.
for name in proc_names:
    if not name.isdigit():
        continue
    root = os.path.join(proc, name)
    try:
        if os.stat(root, follow_symlinks=False).st_uid != uid:
            continue
        with open(os.path.join(root, "cmdline"), "rb") as handle:
            payload = handle.read(65537)
        if len(payload) > 65536:
            raise OSError("oversized process command")
    except FileNotFoundError:
        continue
    except OSError:
        raise SystemExit(0)
    arguments = [
        os.path.basename(part.decode("utf-8", "surrogateescape"))
        for part in payload.split(b"\0")
        if part
    ]
    if "shpool_login" in arguments:
        print("live picker; temp expiry skipped", file=sys.stderr)
        raise SystemExit(0)

flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
flags |= getattr(os, "O_NOFOLLOW", 0)
try:
    directory = os.open(state, flags)
except OSError:
    raise SystemExit(0)

removed = 0
try:
    root_info = os.fstat(directory)
    if (
        root_info.st_uid != uid
        or not stat.S_ISDIR(root_info.st_mode)
        or stat.S_IMODE(root_info.st_mode) != 0o700
    ):
        raise SystemExit(0)
    cutoff_ns = time.time_ns() - 24 * 60 * 60 * 1_000_000_000
    for name in os.listdir(directory):
        if not pattern.fullmatch(name):
            continue
        try:
            before = os.stat(name, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            raise SystemExit(0)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != uid
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_mtime_ns > cutoff_ns
        ):
            continue
        try:
            after = os.stat(name, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            raise SystemExit(0)
        fingerprint = lambda value: (
            value.st_dev,
            value.st_ino,
            value.st_mode,
            value.st_uid,
            value.st_nlink,
            value.st_size,
            value.st_mtime_ns,
        )
        if fingerprint(before) != fingerprint(after):
            continue
        try:
            os.unlink(name, dir_fd=directory)
        except FileNotFoundError:
            continue
        except OSError:
            raise SystemExit(0)
        removed += 1
finally:
    os.close(directory)

print(removed)
PY
  ) || return 0
  [[ $expired =~ ^[0-9]+$ && $expired -gt 0 ]] || return 0
  printf '%s expired_picker_temp_files=%s\n' "$(timestamp)" "$expired" >&2
}

prepare_darwin_proc_snapshot() {
  [[ $REAPER_PLATFORM == Darwin ]] || return 0
  [[ -f $INVENTORY_CORE ]] || fail "Darwin process adapter unavailable"
  DARWIN_PROC_SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/session-kit-proc.XXXXXX") ||
    fail "Darwin process snapshot creation"
  chmod 700 "$DARWIN_PROC_SNAPSHOT" || fail "Darwin process snapshot permissions"
  trap '[[ -z ${DARWIN_PROC_SNAPSHOT:-} ]] || rm -rf -- "$DARWIN_PROC_SNAPSHOT"' EXIT
  local process_json=$DARWIN_PROC_SNAPSHOT/process-table.json
  python3 "$INVENTORY_CORE" platform process-table > "$process_json" || return 1
  chmod 600 "$process_json" || return 1
  DARWIN_DAEMON_PID=$(python3 - "$DARWIN_PROC_SNAPSHOT" "$process_json" <<'PY'
import json
import os
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
payload = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
rows = payload.get("processes") if isinstance(payload, dict) else None
if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
    raise SystemExit("session-kit: invalid Darwin process snapshot")
daemons = []
for row in rows:
    argv = row.get("cmdline")
    if isinstance(argv, list) and argv and pathlib.Path(str(argv[0])).name == "shpool" and "daemon" in argv[1:]:
        daemons.append(row)
if len(daemons) != 1:
    raise SystemExit("session-kit: expected exactly one shpool daemon")
daemon_pid = daemons[0].get("pid")
if not isinstance(daemon_pid, int) or daemon_pid <= 0:
    raise SystemExit("session-kit: invalid shpool daemon identity")
for row in rows:
    if row.get("ppid") != daemon_pid:
        continue
    if row.get("args_available") is not True or not row.get("session_name"):
        raise SystemExit("session-kit: unreadable shpool child; cleanup refused")
for row in rows:
    pid = row.get("pid")
    ppid = row.get("ppid")
    generation = row.get("start_ticks")
    if not all(isinstance(value, int) and value >= 0 for value in (pid, ppid, generation)):
        raise SystemExit("session-kit: invalid Darwin process identity")
    base = root / str(pid)
    base.mkdir(mode=0o700)
    comm = str(row.get("comm") or "process").replace(")", "")[:128]
    fields = ["S", str(ppid), *(["0"] * 17), str(generation), *(["0"] * 30)]
    (base / "stat").write_text(f"{pid} ({comm}) {' '.join(fields)}\n", encoding="utf-8")
    (base / "comm").write_text(f"{comm}\n", encoding="utf-8")
    argv = row.get("cmdline") if isinstance(row.get("cmdline"), list) else []
    (base / "cmdline").write_bytes(b"\0".join(str(value).encode() for value in argv) + (b"\0" if argv else b""))
    session = row.get("session_name")
    environ = b"SHPOOL_SESSION_NAME=" + str(session).encode() + b"\0" if session else b""
    (base / "environ").write_bytes(environ)
    cwd = row.get("cwd")
    if isinstance(cwd, str) and cwd.startswith("/"):
        try:
            os.symlink(cwd, base / "cwd")
        except OSError:
            pass
print(daemon_pid)
PY
  ) || return 1
  command rm -- "$process_json"
}

if [[ -e $SENTINEL ]]; then
  printf '%s reaper disabled by %s\n' "$(timestamp)" "$SENTINEL" >&2
  exit 3
fi
[[ -n $SHPOOL && -x $SHPOOL ]] || fail "shpool executable unavailable"
[[ $MAX_AGE_DAYS =~ ^[0-9]+$ && $MAX_AGE_DAYS -ge 1 ]] || fail "invalid prune age"
[[ $AUTO_CLOSE_HOURS =~ ^[0-9]+$ && $AUTO_CLOSE_HOURS -ge 1 &&
   $AUTO_CLOSE_HOURS -le 8760 ]] || fail "invalid auto-close age"

expire_picker_temp_files

# Immutable releases accumulate one per roll and only `current`, its recorded
# predecessor, and whatever a STANDING window still runs are ever used again.
# Prune the rest once they are old and provably unreferenced; keep the newest
# three regardless, and never more than ten deletions per run.
expire_stale_releases() {
  [[ $MODE != verify && $DRY_RUN != 1 ]] || return 0
  [[ $REAPER_PLATFORM != Darwin ]] || return 0
  python3 - "$PROC_ROOT" <<'PY' || true
import json
import os
import re
import shutil
import sys
import time

proc = os.path.abspath(sys.argv[1])
home = os.path.expanduser("~")
root = os.path.join(home, ".local", "lib", "session-kit")
releases = os.path.join(root, "releases")
if not os.path.isdir(releases):
    raise SystemExit(0)
uid = os.geteuid()

keep: set[str] = set()
try:
    keep.add(os.path.basename(os.path.realpath(os.path.join(root, "current"))))
except OSError:
    raise SystemExit(0)
try:
    with open(
        os.path.join(home, ".local", "state", "session-kit", "install.json"),
        encoding="utf-8",
    ) as handle:
        recorded = json.load(handle)
    for key in ("installed_release", "previous_release"):
        value = recorded.get(key)
        if isinstance(value, str):
            keep.add(value)
except (OSError, ValueError):
    raise SystemExit(0)

# Anything ANY live same-uid process references stays; an unreadable process
# table means no proof, so nothing is deleted.
try:
    for name in os.listdir(proc):
        if not name.isdigit():
            continue
        base = os.path.join(proc, name)
        try:
            if os.stat(base, follow_symlinks=False).st_uid != uid:
                continue
            evidence = []
            with open(os.path.join(base, "cmdline"), "rb") as handle:
                evidence.append(handle.read(65536))
            with open(os.path.join(base, "environ"), "rb") as handle:
                evidence.append(handle.read(131072))
            try:
                evidence.append(os.readlink(os.path.join(base, "cwd")).encode())
            except OSError:
                pass
        except FileNotFoundError:
            continue
        except OSError:
            raise SystemExit(0)
        for blob in evidence:
            for match in re.finditer(rb"releases/([0-9a-f]{40})", blob):
                keep.add(match.group(1).decode())
except OSError:
    raise SystemExit(0)

entries = []
for name in os.listdir(releases):
    if not re.fullmatch(r"[0-9a-f]{40}", name):
        continue
    path = os.path.join(releases, name)
    if os.path.islink(path) or not os.path.isdir(path):
        continue
    try:
        entries.append((os.lstat(path).st_mtime, name))
    except OSError:
        continue
entries.sort(reverse=True)
for _, name in entries[:3]:
    keep.add(name)

cutoff = time.time() - 14 * 86400
removed = 0
for mtime, name in reversed(entries):
    if removed >= 10 or name in keep or mtime > cutoff:
        continue
    target = os.path.join(releases, name)
    # Release dirs are installed read-only; restore owner-write so the
    # removal itself cannot half-fail.
    for directory, _, files in os.walk(target):
        try:
            os.chmod(directory, 0o700)
            for entry in files:
                os.chmod(os.path.join(directory, entry), 0o600)
        except OSError:
            break
    try:
        shutil.rmtree(target)
        removed += 1
    except OSError:
        continue
if removed:
    print(f"release GC removed {removed} stale release(s)", file=sys.stderr)
PY
}
expire_stale_releases

if [[ $REAPER_PLATFORM == Darwin ]]; then
  prepare_darwin_proc_snapshot || fail "Darwin process snapshot unavailable"
  PROC_ROOT=$DARWIN_PROC_SNAPSHOT
  daemon_pid=$DARWIN_DAEMON_PID
fi

json=$("$SHPOOL" list --json 2>/dev/null) || fail "shpool list error"
daemon_pid=${SESSION_KIT_DAEMON_PID:-${daemon_pid:-}}
if [[ -z $daemon_pid && $REAPER_PLATFORM == Darwin ]]; then
  daemon_pid=$(python3 - "$PROC_ROOT" <<'PY'
import pathlib,sys
root=pathlib.Path(sys.argv[1])
for entry in root.iterdir():
    try:
        argv=(entry/"cmdline").read_bytes().split(b"\0")
    except OSError:
        continue
    if argv and pathlib.Path(argv[0].decode("utf-8","replace")).name=="shpool" and b"daemon" in argv[1:]:
        print(entry.name)
        break
PY
)
elif [[ -z $daemon_pid && $PROC_ROOT == /proc ]]; then
  daemon_pid=$(pgrep -f '^.*/shpool daemon$' | head -1)
fi
[[ $daemon_pid =~ ^[0-9]+$ ]] || fail "daemon PID unavailable"

if [[ $MODE == auto ]]; then
  [[ -x $STATUS ]] || fail "guard-live status command unavailable"
  [[ -f $RELEASE_DIR/lib/sessionkit_inventory/reaper.py ]] ||
    fail "auto-close planner unavailable"
  inventory=$("$STATUS" --guard-json 2>/dev/null) ||
    fail "guard-live inventory unavailable"
  export SK_REAPER_SHPOOL_JSON=$json
  export SK_REAPER_INVENTORY_JSON=$inventory
  export SK_REAPER_STATE_DIR=$STATE_DIR
  export SK_REAPER_PROC_ROOT=$PROC_ROOT
  export SK_REAPER_DAEMON_PID=$daemon_pid
  export SK_REAPER_AUTO_CLOSE_HOURS=$AUTO_CLOSE_HOURS
  plan_args=(plan)
  if [[ $DRY_RUN == 1 ]]; then plan_args+=(--no-write); fi
  plan=$(PYTHONPATH="$RELEASE_DIR/lib" \
    python3 -m sessionkit_inventory.reaper "${plan_args[@]}") ||
    fail "auto-close planning failed"
  if [[ $DRY_RUN == 1 ]]; then
    printf '%s\n' "$plan"
    exit 0
  fi
  umask 077
  mkdir -p "$STATE_DIR" || fail "state directory creation"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  candidate_file=$STATE_DIR/auto-close-candidates.json
  [[ -f $candidate_file && ! -L $candidate_file ]] ||
    fail "auto-close candidate document unavailable"
  candidate_count=$(python3 - "$candidate_file" <<'PY'
import json,sys
value=json.load(open(sys.argv[1],encoding="utf-8"))
items=value.get("candidates") if isinstance(value,dict) else None
if not isinstance(items,list):
    raise SystemExit(1)
print(len(items))
PY
  ) || fail "auto-close candidate document is invalid"
  if [[ $candidate_count == 0 ]]; then
    printf '%s\n' "$plan"
    exit 0
  fi
  # The creation lock is the shared Session Kit attach/create/close barrier.
  # Reuse the privacy-minimal capped action log already used by picker actions.
  # shellcheck source=bin/session_kit_common
  source "$SCRIPT_DIR/session_kit_common"
  sk_prepare_state || fail "private action state unavailable"
  exec 9>"$STATE_DIR/create.lock" || fail "creation lock unavailable"
  sk_lock_acquire 9 "$STATE_DIR/create.lock" || fail "creation lock unavailable"
  actions=0
  proof=
  trap '[[ -z ${proof:-} ]] || rm -f -- "$proof"' EXIT
  for (( candidate_index=0; candidate_index<candidate_count; candidate_index++ )); do
    proof=$(mktemp "$STATE_DIR/auto-close-proof.XXXXXX.json") ||
      fail "private candidate proof creation"
    chmod 600 "$proof" || fail "private candidate proof permissions"
    python3 - "$candidate_file" "$candidate_index" "$proof" <<'PY' ||
import json,os,sys
source,index,destination=sys.argv[1],int(sys.argv[2]),sys.argv[3]
value=json.load(open(source,encoding="utf-8"))
item=value["candidates"][index]
with open(destination,"w",encoding="utf-8") as handle:
    json.dump(item,handle,sort_keys=True)
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())
PY
      fail "private candidate proof extraction"
    target=$(python3 - "$proof" <<'PY'
import json,sys
value=json.load(open(sys.argv[1],encoding="utf-8"))
target=value.get("shpool_id") if isinstance(value,dict) else None
if not isinstance(target,str):
    raise SystemExit(1)
print(target)
PY
    ) || fail "private candidate target is invalid"
    for verification_pass in 1 2; do
      json=$("$SHPOOL" list --json 2>/dev/null) ||
        fail "fresh shpool list error"
      inventory=$("$STATUS" --guard-json 2>/dev/null) ||
        fail "fresh guard-live inventory unavailable"
      export SK_REAPER_SHPOOL_JSON=$json
      export SK_REAPER_INVENTORY_JSON=$inventory
      PYTHONPATH="$RELEASE_DIR/lib" \
        python3 -m sessionkit_inventory.reaper verify "$proof" >/dev/null ||
        fail "auto-close candidate changed or is no longer safe"
    done
    sk_log_action auto_close requested ||
      fail "private action log unavailable; nothing closed"
    "$SHPOOL" kill "$target" >/dev/null 2>&1 ||
      fail "exact auto-close action failed"
    after=$("$SHPOOL" list --json 2>/dev/null) ||
      fail "post-close shpool list error"
    SK_REAPER_POST_JSON=$after python3 - "$target" <<'PY' ||
import json,os,sys
payload=json.loads(os.environ["SK_REAPER_POST_JSON"])
rows=payload.get("sessions") if isinstance(payload,dict) else payload
if not isinstance(rows,list):
    raise SystemExit(1)
raise SystemExit(1 if any(
    isinstance(row,dict) and row.get("name")==sys.argv[1] for row in rows
) else 0)
PY
      fail "closed target is still present"
    sk_log_action auto_close closed ||
      fail "close succeeded but private action log update failed"
    rm -f -- "$proof"
    proof=
    actions=$((actions + 1))
  done
  trap - EXIT
  printf 'auto_candidates=%s actions=%s\n' "$candidate_count" "$actions"
  exit 0
fi

if [[ $MODE == verify ]]; then
  [[ -f $VERIFY_FILE && ! -L $VERIFY_FILE ]] || fail "candidate proof is not a regular file"
  export SK_REAPER_JSON=$json
  export SK_REAPER_VERIFY_FILE=$VERIFY_FILE
  export SK_REAPER_PROC_ROOT=$PROC_ROOT
  export SK_REAPER_DAEMON_PID=$daemon_pid
  export SK_REAPER_MAX_AGE_DAYS=$MAX_AGE_DAYS
  python3 <<'PY' || fail "candidate changed or is no longer empty"
import json, os, pathlib, re, time

payload = json.loads(os.environ["SK_REAPER_JSON"])
rows = payload.get("sessions") if isinstance(payload, dict) else payload
candidate = json.loads(pathlib.Path(os.environ["SK_REAPER_VERIFY_FILE"]).read_text())
proc_root = pathlib.Path(os.environ["SK_REAPER_PROC_ROOT"])
daemon_pid = int(os.environ["SK_REAPER_DAEMON_PID"])
required = (
    "shpool_id",
    "started_at_unix_ms",
    "last_disconnected_at_unix_ms",
    "shell_pid",
    "shell_start_ticks",
)
if not isinstance(rows, list) or not isinstance(candidate, dict):
    raise SystemExit(2)
if any(key not in candidate for key in required):
    raise SystemExit(2)
session_id = candidate["shpool_id"]
if not isinstance(session_id, str) or len(session_id.encode()) > 128:
    raise SystemExit(2)
disconnected = candidate["last_disconnected_at_unix_ms"]
if not isinstance(disconnected, int):
    raise SystemExit(2)
minimum_age_ms = int(os.environ["SK_REAPER_MAX_AGE_DAYS"]) * 86400 * 1000
if int(time.time() * 1000) - disconnected < minimum_age_ms:
    raise SystemExit(2)
if not re.fullmatch(r"(?:main(?:[1-9][0-9]*)?|s[0-9]{8}-[0-9]{6}-[1-9][0-9]*(?:-[1-9][0-9]*)?)", session_id):
    raise SystemExit(2)
matched = [
    row for row in rows
    if isinstance(row, dict)
    and row.get("name") == session_id
    and row.get("started_at_unix_ms") == candidate["started_at_unix_ms"]
    and row.get("last_disconnected_at_unix_ms") == disconnected
    and str(row.get("status", "")).lower() == "disconnected"
]
if len(matched) != 1:
    raise SystemExit(2)

def stat(pid):
    try:
        text = (proc_root / str(pid) / "stat").read_text()
    except OSError:
        return None
    end = text.rfind(")")
    fields = text[end + 2:].split()
    if len(fields) < 20:
        return None
    return int(fields[1]), int(fields[19])

def read_bytes(pid, name):
    return (proc_root / str(pid) / name).read_bytes()

processes = {}
try:
    pids = sorted(int(entry.name) for entry in proc_root.iterdir() if entry.name.isdigit())
except OSError:
    raise SystemExit(2)
for pid in pids:
    before = stat(pid)
    if before is None:
        continue
    try:
        comm = read_bytes(pid, "comm").decode("utf-8", "replace").strip()
        cmdline = read_bytes(pid, "cmdline").replace(b"\0", b" ").decode("utf-8", "replace")
        environ = read_bytes(pid, "environ").split(b"\0")
    except OSError:
        comm = None
        cmdline = None
        environ = None
    after = stat(pid)
    if before != after:
        continue
    processes[pid] = {
        "ppid": before[0],
        "start_ticks": before[1],
        "comm": comm,
        "cmdline": cmdline,
        "environ": environ,
    }

children = {}
for pid, row in processes.items():
    children.setdefault(row["ppid"], []).append(pid)
shells = []
for pid in children.get(daemon_pid, []):
    environ = processes[pid]["environ"]
    if environ is None:
        continue
    for item in environ:
        if item.startswith(b"SHPOOL_SESSION_NAME="):
            if item.split(b"=", 1)[1].decode("utf-8", "replace") == session_id:
                shells.append(pid)
            break
if len(shells) != 1:
    raise SystemExit(2)
shell = shells[0]
if shell != candidate["shell_pid"] or processes[shell]["start_ticks"] != candidate["shell_start_ticks"]:
    raise SystemExit(2)
direct = children.get(shell, [])
if direct:
    if len(direct) != 1:
        raise SystemExit(2)
    wrapper = direct[0]
    row = processes[wrapper]
    if row["comm"] != "script" or "bash -i" not in row["cmdline"]:
        raise SystemExit(2)
    inner = children.get(wrapper, [])
    if len(inner) != 1 or processes[inner[0]]["comm"] not in {"bash", "sh"}:
        raise SystemExit(2)
    if children.get(inner[0], []):
        raise SystemExit(2)
if stat(shell) != (processes[shell]["ppid"], processes[shell]["start_ticks"]):
    raise SystemExit(2)
PY
  if [[ $REAPER_PLATFORM == Darwin ]]; then
    read -r native_shell_pid native_shell_generation < <(
      python3 - "$VERIFY_FILE" <<'PY'
import json,sys
value=json.load(open(sys.argv[1],encoding="utf-8"))
print(value.get("shell_pid", ""), value.get("shell_start_ticks", ""))
PY
    )
    [[ $native_shell_pid =~ ^[0-9]+$ && $native_shell_generation =~ ^[0-9]+$ ]] ||
      fail "candidate has no native shell generation"
    python3 "$INVENTORY_CORE" platform process-generation-is \
      "$native_shell_pid" "$native_shell_generation" >/dev/null 2>&1 ||
      fail "candidate shell generation changed"
  fi
  second=$("$SHPOOL" list --json 2>/dev/null) || fail "second shpool list error"
  export SK_REAPER_SECOND_JSON=$second
  python3 - "$VERIFY_FILE" <<'PY' || fail "candidate changed after process proof"
import json,os,sys
candidate=json.load(open(sys.argv[1]))
payload=json.loads(os.environ["SK_REAPER_SECOND_JSON"])
rows=payload.get("sessions") if isinstance(payload,dict) else payload
matches=[
    row for row in rows
    if isinstance(row,dict)
    and row.get("name")==candidate["shpool_id"]
    and row.get("started_at_unix_ms")==candidate["started_at_unix_ms"]
    and row.get("last_disconnected_at_unix_ms")==candidate["last_disconnected_at_unix_ms"]
    and str(row.get("status","")).lower()=="disconnected"
]
raise SystemExit(0 if len(matches)==1 else 1)
PY
  echo "candidate verified exact, disconnected, and empty"
  exit 0
fi

if [[ $DRY_RUN != 1 ]]; then
  umask 077
  mkdir -p "$STATE_DIR" || fail "state directory creation"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
fi

export SK_REAPER_JSON=$json
export SK_REAPER_STATE_DIR=$STATE_DIR
export SK_REAPER_PROC_ROOT=$PROC_ROOT
export SK_REAPER_DAEMON_PID=$daemon_pid
export SK_REAPER_MAX_AGE_DAYS=$MAX_AGE_DAYS
export SK_REAPER_DRY_RUN=$DRY_RUN

summary=$(python3 <<'PY'
import json, os, pathlib, tempfile, time

payload = json.loads(os.environ["SK_REAPER_JSON"])
rows = payload.get("sessions") if isinstance(payload, dict) else payload
if not isinstance(rows, list):
    raise SystemExit(2)
for row in rows:
    if not isinstance(row, dict) or not isinstance(row.get("name"), str):
        raise SystemExit(2)

state_dir = pathlib.Path(os.environ["SK_REAPER_STATE_DIR"])
proc_root = pathlib.Path(os.environ["SK_REAPER_PROC_ROOT"])
daemon_pid = int(os.environ["SK_REAPER_DAEMON_PID"])
age_ms = int(os.environ["SK_REAPER_MAX_AGE_DAYS"]) * 86400 * 1000
dry = os.environ["SK_REAPER_DRY_RUN"] == "1"
now_ms = int(time.time() * 1000)

def proc_bytes(pid, name):
    try:
        return (proc_root / str(pid) / name).read_bytes()
    except OSError:
        return b""

def proc_text(pid, name):
    return proc_bytes(pid, name).decode("utf-8", "replace")

def proc_stat(pid):
    text = proc_text(pid, "stat")
    if not text:
        return None
    end = text.rfind(")")
    fields = text[end + 2:].split()
    if len(fields) < 20:
        return None
    return {"ppid": int(fields[1]), "start_ticks": int(fields[19])}

pids = []
if proc_root.exists():
    for entry in proc_root.iterdir():
        if entry.name.isdigit():
            pids.append(int(entry.name))
children = {}
stats = {}
processes = {}
for pid in pids:
    before = proc_stat(pid)
    if not before:
        continue
    comm_value = proc_text(pid, "comm").strip()
    cmdline_value = proc_bytes(pid, "cmdline").replace(b"\0", b" ").decode("utf-8", "replace")
    environ_value = proc_bytes(pid, "environ").split(b"\0")
    after = proc_stat(pid)
    if before != after:
        continue
    stats[pid] = before
    processes[pid] = {
        "comm": comm_value,
        "cmdline": cmdline_value,
        "environ": environ_value,
    }
    children.setdefault(before["ppid"], []).append(pid)

shells = {}
for pid in children.get(daemon_pid, []):
    for item in processes[pid]["environ"]:
        if item.startswith(b"SHPOOL_SESSION_NAME="):
            shells[item.split(b"=", 1)[1].decode("utf-8", "replace")] = pid
            break

def comm(pid):
    return processes.get(pid, {}).get("comm", "")

def cmdline(pid):
    return processes.get(pid, {}).get("cmdline", "")

def verified_empty(shell_pid):
    direct = children.get(shell_pid, [])
    if not direct:
        return True
    if len(direct) != 1:
        return False
    wrapper = direct[0]
    if comm(wrapper) != "script" or "bash -i" not in cmdline(wrapper):
        return False
    inner = children.get(wrapper, [])
    if len(inner) != 1 or comm(inner[0]) not in {"bash", "sh"}:
        return False
    return not children.get(inner[0], [])

previous_path = state_dir / "reaper-observations.json"
try:
    previous = json.loads(previous_path.read_text()).get("observations", {})
except (OSError, ValueError, AttributeError):
    previous = {}

observations = {}
candidates = []
for row in rows:
    name = row["name"]
    status = str(row.get("status", "")).lower()
    disconnected = row.get("last_disconnected_at_unix_ms")
    shell_pid = shells.get(name)
    stat = stats.get(shell_pid) if shell_pid else None
    if status != "disconnected" or not isinstance(disconnected, int) or not shell_pid or not stat:
        continue
    key = f'{row.get("started_at_unix_ms")}:{disconnected}:{shell_pid}:{stat["start_ticks"]}'
    empty = verified_empty(shell_pid)
    observations[name] = {
        "key": key,
        "first_verified_at_unix_ms": previous.get(name, {}).get("first_verified_at_unix_ms", now_ms)
        if previous.get(name, {}).get("key") == key and empty else now_ms,
        "empty": empty,
    }
    prior = previous.get(name, {})
    old_enough = now_ms - disconnected >= age_ms
    seen_twice = prior.get("key") == key and prior.get("empty") is True
    if empty and old_enough and seen_twice:
        candidates.append({
            "shpool_id": name,
            "started_at_unix_ms": row.get("started_at_unix_ms"),
            "last_disconnected_at_unix_ms": disconnected,
            "shell_pid": shell_pid,
            "shell_start_ticks": stat["start_ticks"],
        })

candidate_doc = {
    "schema_version": 1,
    "generated_at_unix_ms": now_ms,
    "policy": "confirmed-prune-only",
    "candidates": candidates,
}
observation_doc = {
    "schema_version": 1,
    "generated_at_unix_ms": now_ms,
    "observations": observations,
}

def atomic_json(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass

if not dry:
    atomic_json(previous_path, observation_doc)
    atomic_json(state_dir / "prune-candidates.json", candidate_doc)

print(f"sessions={len(rows)} disconnected={sum(str(r.get('status','')).lower() == 'disconnected' for r in rows)} candidates={len(candidates)} actions=0")
PY
) || fail "invalid inventory or process map"

if [[ $DRY_RUN != 1 ]]; then
  printf '%s %s\n' "$(timestamp)" "$summary" >> "$STATE_DIR/reaper.log"
  chmod 600 "$STATE_DIR/reaper.log" 2>/dev/null || true
fi

printf '%s\n' "$summary"
