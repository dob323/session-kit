#!/usr/bin/env python3
"""Build a deterministic public archive with checksum and provenance."""

from __future__ import annotations

import argparse
import gzip
import hashlib
import io
import json
from pathlib import Path, PurePosixPath
import re
import subprocess
import tarfile
import tempfile


ROOT = Path(__file__).resolve().parents[1]
SHA = re.compile(r"^[0-9a-f]{40}$")
BUILD_INPUTS = (
    "public-files.txt",
    "tools/build-public-tree",
    "tools/build-release-artifact",
    "tools/check-doc-links",
    "tools/public-scan",
)


def entry_order(relative: str) -> tuple[str, ...]:
    """Order entries by path component, never by raw string.

    Sorting `Path` objects delegates to the interpreter's own path comparison,
    so the archive layout and the tree digest would depend on the Python build
    that produced them. Ordering by components is fixed by this file alone.
    """
    return PurePosixPath(relative).parts


def digest_entries(entries: list[tuple[str, int, bytes]]) -> str:
    digest = hashlib.sha256()
    for relative, mode, payload in sorted(
        entries, key=lambda entry: entry_order(entry[0])
    ):
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(f"{mode:o}".encode("ascii"))
        digest.update(b"\0")
        digest.update(hashlib.sha256(payload).digest())
    return digest.hexdigest()


def tree_digest(root: Path) -> str:
    return digest_entries(
        [
            (
                path.relative_to(root).as_posix(),
                path.stat().st_mode & 0o777,
                path.read_bytes(),
            )
            for path in root.rglob("*")
            if path.is_file()
        ]
    )


def require_reachable(commit: str) -> None:
    """Refuse a commit no ref reaches: it can be collected, and then the
    artifact's recorded source disappears from the repository."""
    ancestor = subprocess.run(
        ["git", "-C", str(ROOT), "merge-base", "--is-ancestor", commit, "HEAD"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if ancestor.returncode == 0:
        return
    refs = subprocess.run(
        [
            "git",
            "-C",
            str(ROOT),
            "for-each-ref",
            "--contains",
            commit,
            "--count=1",
            "--format=%(refname)",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if refs.returncode == 0 and refs.stdout.strip():
        return
    raise RuntimeError(
        f"release commit is not reachable from HEAD or any ref: {commit}"
    )


def verify_archive(
    archive_path: Path,
    prefix: str,
    commit: str,
    expected_digest: str,
) -> None:
    """Read the built archive back and prove what it contains and records."""
    entries: list[tuple[str, int, bytes]] = []
    with tarfile.open(archive_path, "r:gz") as archive:
        for member in archive:
            name = member.name
            if name.startswith("/") or ".." in Path(name).parts:
                raise RuntimeError(f"unsafe archive member: {name}")
            if name != prefix and not name.startswith(f"{prefix}/"):
                raise RuntimeError(f"archive member outside the prefix: {name}")
            if member.isdir():
                continue
            if not member.isfile():
                raise RuntimeError(f"unsupported archive member: {name}")
            payload = archive.extractfile(member)
            if payload is None:
                raise RuntimeError(f"unreadable archive member: {name}")
            entries.append(
                (name[len(prefix) + 1 :], member.mode & 0o777, payload.read())
            )
    if digest_entries(entries) != expected_digest:
        raise RuntimeError("archive content does not match the exported public tree")
    records = [payload for relative, _, payload in entries if relative == "SOURCE.json"]
    if not records:
        raise RuntimeError("archive does not contain SOURCE.json")
    if json.loads(records[0]).get("source_commit") != commit:
        raise RuntimeError("archive does not record the requested commit")


def require_committed_builder(commit: str) -> None:
    for relative in BUILD_INPUTS:
        committed = subprocess.run(
            ["git", "-C", str(ROOT), "show", f"{commit}:{relative}"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).stdout
        if (ROOT / relative).read_bytes() != committed:
            raise RuntimeError(
                f"release build input differs from requested commit: {relative}"
            )


def add_tree(archive: tarfile.TarFile, source: Path, prefix: str) -> None:
    root_info = tarfile.TarInfo(prefix)
    root_info.type = tarfile.DIRTYPE
    root_info.mode = 0o755
    root_info.mtime = 0
    archive.addfile(root_info)

    for path in sorted(
        source.rglob("*"),
        key=lambda item: entry_order(item.relative_to(source).as_posix()),
    ):
        relative = path.relative_to(source).as_posix()
        info = tarfile.TarInfo(f"{prefix}/{relative}")
        info.mtime = 0
        info.uid = 0
        info.gid = 0
        info.uname = ""
        info.gname = ""
        if path.is_dir():
            info.type = tarfile.DIRTYPE
            info.mode = 0o755
            archive.addfile(info)
            continue
        if not path.is_file() or path.is_symlink():
            raise RuntimeError(f"unsupported artifact entry: {relative}")
        payload = path.read_bytes()
        info.mode = path.stat().st_mode & 0o777
        info.size = len(payload)
        archive.addfile(info, fileobj=io.BytesIO(payload))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--commit", required=True)
    parser.add_argument("--output-dir", required=True, type=Path)
    args = parser.parse_args()
    if not SHA.fullmatch(args.commit):
        parser.error("--commit must be a full lowercase Git commit")
    subprocess.run(
        ["git", "-C", str(ROOT), "rev-parse", "--verify", f"{args.commit}^{{commit}}"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    require_reachable(args.commit)
    require_committed_builder(args.commit)

    output = args.output_dir.resolve()
    if output == ROOT or ROOT in output.parents:
        parser.error("output directory must be outside the source repository")
    if output.exists() and any(output.iterdir()):
        parser.error("output directory must be absent or empty")
    output.mkdir(parents=True, exist_ok=True)

    basename = f"session-kit-{args.commit}"
    archive_path = output / f"{basename}.tar.gz"
    checksum_path = output / f"{basename}.sha256"
    provenance_path = output / f"{basename}.provenance.json"

    with tempfile.TemporaryDirectory(
        prefix="session-kit-release.",
        dir=output.parent,
    ) as temporary:
        temporary_root = Path(temporary)
        public_tree = temporary_root / "public"
        subprocess.run(
            [
                str(ROOT / "tools/build-public-tree"),
                "--commit",
                args.commit,
                "--destination",
                str(public_tree),
            ],
            cwd=ROOT,
            check=True,
        )
        public_digest = tree_digest(public_tree)
        plain_tar = temporary_root / f"{basename}.tar"
        with tarfile.open(plain_tar, "w", format=tarfile.GNU_FORMAT) as archive:
            add_tree(archive, public_tree, basename)
        with plain_tar.open("rb") as source, archive_path.open("wb") as raw_output:
            with gzip.GzipFile(
                filename="",
                mode="wb",
                fileobj=raw_output,
                mtime=0,
            ) as compressed:
                while chunk := source.read(1024 * 1024):
                    compressed.write(chunk)

    try:
        verify_archive(archive_path, basename, args.commit, public_digest)
    except Exception:
        archive_path.unlink(missing_ok=True)
        raise

    archive_digest = hashlib.sha256(archive_path.read_bytes()).hexdigest()
    checksum_path.write_text(
        f"{archive_digest}  {archive_path.name}\n",
        encoding="utf-8",
    )
    provenance = {
        "schema_version": 1,
        "source_commit": args.commit,
        "builder_commit": args.commit,
        "archive": archive_path.name,
        "archive_sha256": archive_digest,
        # The archive was read back after the build: its files match the exported
        # tree digest and its SOURCE.json records this exact source commit.
        "archive_verified": True,
        "public_tree_sha256": public_digest,
        "build_tool": "tools/build-release-artifact",
        "reproducible_timestamps": True,
    }
    provenance_path.write_text(
        json.dumps(provenance, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    for path in (archive_path, checksum_path, provenance_path):
        path.chmod(0o644)
    print(json.dumps(provenance, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
