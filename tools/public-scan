def scan_text(
    label: str,
    payload: bytes,
    patterns: dict[str, re.Pattern[str]],
    *,
    private_markers: bool,
) -> list[str]:
    if len(payload) > TEXT_LIMIT:
        return [f"{label}: file exceeds scan limit"]
    if b"\0" in payload:
        return [f"{label}: binary file is not allowed"]
    text = payload.decode("utf-8", "replace")
    failures = [
        f"{label}: {name}" for name, pattern in patterns.items() if pattern.search(text)
    ]
    if private_markers:
        for token in re.findall(r"[A-Za-z0-9_]+", text.casefold()):
            # A snake_case identifier must not smuggle a private word past the
            # check, so every underscore-separated part is tested as well as
            # the whole token.
            parts = {token, *token.split("_")}
            if any(
                hashlib.sha256(part.encode("utf-8")).hexdigest()
                in PRIVATE_TOKEN_DIGESTS
                for part in parts
                if part
            ):
                failures.append(f"{label}{MARKER_FAILURE}")
                break
    return failures


def scan_payload(
    label: str,
    path: str,
    payload: bytes,
    patterns: dict[str, re.Pattern[str]],
    *,
    private_markers: bool,
) -> list[str]:
    expected_digests = APPROVED_BINARY_SHA256.get(path)
    if expected_digests is not None:
        actual_digest = hashlib.sha256(payload).hexdigest()
        if actual_digest not in expected_digests:
            return [f"{label}: approved binary digest mismatch"]
        return []
    return scan_text(label, payload, patterns, private_markers=private_markers)


def scan_tree(
    root: Path,
    patterns: dict[str, re.Pattern[str]],
    *,
    private_markers: bool,
) -> list[str]:
    failures: list[str] = []
    for path in sorted(root.rglob("*")):
        if (
            any(part in IGNORED_PARTS for part in path.parts)
            or path.name in IGNORED_NAMES
            or path.suffix in {".pyc", ".pyo"}
        ):
            continue
        relative = path.relative_to(root)
        if path.is_symlink():
            failures.append(f"{relative}: symlink is not allowed")
            continue
        if path.is_dir():
            continue
        failures.extend(
            scan_payload(
                str(relative),
                relative.as_posix(),
                path.read_bytes(),
                patterns,
                private_markers=private_markers,
            )
        )
    return failures


MARKER_FAILURE = ": private marker"
BASELINE_ENTRY = re.compile(r"^([0-9a-f]{40})(?:\s+(\S.*))?$")


class BaselineError(Exception):
    """The grandfathered-history list could not be read exactly."""


def load_baseline(path: Path) -> frozenset[str]:
    """Read the reviewed history blobs the private-marker rule may skip.

    Every failure mode here is fatal on purpose. A baseline that silently
    parses to nothing would turn the history scan back into a pass with no
    evidence behind it, which is the one outcome a fail-closed check must
    never produce.
    """
    try:
        payload = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise BaselineError(f"baseline is unreadable: {exc}") from exc
    blobs: set[str] = set()
    for number, line in enumerate(payload.splitlines(), 1):
        entry = line.split("#", 1)[0].strip()
        if not entry:
            continue
        match = BASELINE_ENTRY.fullmatch(entry)
        if match is None:
            raise BaselineError(f"malformed baseline line {number}: {line!r}")
        blob = match.group(1)
        if blob in blobs:
            raise BaselineError(f"duplicate baseline blob on line {number}: {blob}")
        blobs.add(blob)
    if not blobs:
        raise BaselineError("baseline lists no blobs")
    return frozenset(blobs)


def git(root: Path, *args: str, text: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=text,
    )


def scan_history(
    root: Path,
    patterns: dict[str, re.Pattern[str]],
    *,
    private_markers: bool,
    baseline: frozenset[str] = frozenset(),
    applied: set[str] | None = None,
) -> list[str]:
    try:
        rows = git(root, "rev-list", "--objects", "--all").stdout.splitlines()
    except subprocess.CalledProcessError as exc:
        detail = exc.stderr.strip() or "not a Git repository"
        return [f"Git history unavailable: {detail}"]

    failures: list[str] = []
    seen: set[str] = set()
    for row in rows:
        object_id, _, path = row.partition(" ")
        if object_id in seen:
            continue
        seen.add(object_id)
        if git(root, "cat-file", "-t", object_id).stdout.strip() != "blob":
            continue
        size = int(git(root, "cat-file", "-s", object_id).stdout.strip())
        label = f"history {object_id[:12]}"
        if path:
            label += f" ({path})"
        if size > TEXT_LIMIT:
            failures.append(f"{label}: file exceeds scan limit")
            continue
        payload = git(root, "cat-file", "blob", object_id, text=False).stdout
        found = scan_payload(
            label,
            path,
            payload,
            patterns,
            private_markers=private_markers,
        )
        if object_id in baseline:
            # A baselined blob is exempt from the private-marker rule and from
            # nothing else. Secrets still fail, so listing a blob can never be
            # a way to publish a leaked credential: the exemption is keyed to
            # the exact content, and edited content is a different object.
            excused = [item for item in found if item.endswith(MARKER_FAILURE)]
            if excused and applied is not None:
                applied.add(object_id)
            found = [item for item in found if not item.endswith(MARKER_FAILURE)]
        failures.extend(found)
    return failures


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("root", nargs="?", default=".", type=Path)
    parser.add_argument(
        "--git-history",
        action="store_true",
        help="scan every blob reachable from local Git refs",
    )
    parser.add_argument(
        "--private-markers",
        action="store_true",
        help="also reject repository-specific private markers",
    )
    parser.add_argument(
        "--baseline",
        type=Path,
        help=(
            "file listing reviewed history blobs that predate a private marker; "
            "exempts those exact blobs from the private-marker rule only"
        ),
    )
    args = parser.parse_args()
    root = args.root.resolve()
    if not root.is_dir():
        parser.error("root must be a directory")
    baseline: frozenset[str] = frozenset()
    if args.baseline is not None:
        if not args.git_history:
            parser.error("--baseline applies to --git-history scans")
        try:
            baseline = load_baseline(args.baseline)
        except BaselineError as exc:
            parser.error(str(exc))

    failures = scan_tree(
        root,
        SECRETS,
        private_markers=args.private_markers,
    )
    applied: set[str] = set()
    if args.git_history:
        failures.extend(
            scan_history(
                root,
                SECRETS,
                private_markers=args.private_markers,
                baseline=baseline,
                applied=applied,
            )
        )
    failures = sorted(set(failures))
    if failures:
        print("public scan failed:")
        for failure in failures:
            print(f"  {failure}")
        return 1
    scope = "tree and Git history" if args.git_history else "tree"
    if baseline:
        # Say what the baseline actually did here, not how long the list is.
        # A gap between the two is how a stale entry becomes visible.
        scope += (
            f", {len(applied)} of {len(baseline)} baselined history blob(s) excused"
        )
    print(f"public scan passed ({scope})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
