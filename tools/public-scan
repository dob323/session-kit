#!/usr/bin/env python3
"""Scan a public tree, and optionally its Git history, without printing secrets."""

from __future__ import annotations

import argparse
import hashlib
from pathlib import Path
import re
import subprocess


TEXT_LIMIT = 4 * 1024 * 1024
IGNORED_PARTS = {".git", ".mypy_cache", ".ruff_cache", "__pycache__"}
IGNORED_NAMES = {".coverage"}
