[Unit]
Description=Close exactly verified provider-exited Session Kit terminals

[Service]
Type=oneshot
# The user manager's default PATH omits the provider CLI and shpool homes;
# the guard-live snapshot needs all three list commands resolvable.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/shpool_reaper --auto-close
