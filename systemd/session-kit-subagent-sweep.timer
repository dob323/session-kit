[Unit]
Description=Session Kit, five-minute sweep for finished sub-agent workers

[Timer]
# The operator's rule is "close it 15 minutes after it's finished", and idle
# is measured between passes: an hourly pass could only ever deliver that
# promise within about 75 minutes. Five minutes delivers it within about 20.
# This is its own timer rather than a faster shpool-reaper.timer because that
# pass also builds a full guard-live inventory and runs the 72-hour terminal
# auto-close, expensive, destructive, and governed by thresholds that a
# twelve-times-faster cadence buys nothing for.
OnBootSec=2min
OnUnitActiveSec=5min
# No Persistent=: a missed sweep has nothing to catch up. The next pass reads
# the same live /proc and reaches the same answer.
AccuracySec=30s

[Install]
WantedBy=timers.target
