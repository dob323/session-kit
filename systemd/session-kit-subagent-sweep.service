[Unit]
Description=Session Kit, close finished sub-agent worker processes

[Service]
Type=oneshot
# The user manager's default PATH omits the provider CLI and shpool homes.
# This pass needs far less than the reaper does (it reads /proc and signals),
# but it runs the same program, so it is given the same PATH.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/shpool_reaper --sweep-subagents
